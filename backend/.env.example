# Copy this file to .env and fill in your values

# Database — SQLite for local dev (default), or paste your Supabase PostgreSQL URL for production
DATABASE_URL=sqlite:///./meeting_assistant.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret — 沒設的話程式會直接啟動失敗（刻意不給預設值）
# 產生一個：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 跨來源請求。前後端同源時留空即可；要開放就填網域，逗號分隔
ALLOWED_ORIGINS=

# Resend (email) — get a free key at resend.com
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
