# Copy this file to .env and fill in your values

# Database — SQLite for local dev (default), or paste your Supabase PostgreSQL URL for production
DATABASE_URL=sqlite:///./meeting_assistant.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret — use any long random string
SECRET_KEY=change-this-to-a-long-random-secret

# Resend (email) — get a free key at resend.com
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
